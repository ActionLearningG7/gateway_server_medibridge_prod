# ============================================================================
# API Gateway Configuration - Environment Variables
# ============================================================================
# Copy to .env.dev, .env.test, .env.prod and adjust values accordingly.
# ============================================================================

# ==============================================================================
# Server Configuration
# ==============================================================================
SERVER_PORT_DEV=8080
SERVER_PORT_TEST=8080
SERVER_PORT_PROD=8080

# ==============================================================================
# Database Configuration (API Gateway doesn't use DB, but keeping for consistency)
# ==============================================================================
# DB_HOST_DEV=localhost
# DB_HOST_TEST=test-db
# DB_HOST_PROD=prod-db

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_URL_DEV=redis://localhost:6379
REDIS_URL_TEST=redis://test-redis:6379
REDIS_URL_PROD=redis://prod-redis:6379

# ==============================================================================
# JWT Configuration
# ==============================================================================
# IMPORTANT: Must match across all services!
JWT_SECRET_DEV=MediBridge2026!Dev$ecretK3y#Tes7Env@Secur1ty
JWT_SECRET_TEST=MediBridge2026!Test$ecretK3y#Tes7Env@Secur1ty
JWT_SECRET_PROD=MediBridge2026!Prod$ecretK3y#H0sp1talManag3m3ntSyst3m@Secur1ty

JWT_EXPIRATION_MS_DEV=3600000
JWT_EXPIRATION_MS_TEST=3600000
JWT_EXPIRATION_MS_PROD=3600000

JWT_REFRESH_EXPIRATION_MS_DEV=86400000
JWT_REFRESH_EXPIRATION_MS_TEST=86400000
JWT_REFRESH_EXPIRATION_MS_PROD=86400000

# ==============================================================================
# CORS Configuration
# ==============================================================================
CORS_ALLOWED_ORIGINS_DEV=http://localhost:3000,http://localhost:4200,http://localhost:8080
CORS_ALLOWED_ORIGINS_TEST=http://test-frontend:3000,http://test-api:8080
CORS_ALLOWED_ORIGINS_PROD=https://medibridge-prod.vercel.app,https://api.medibridge.com

# ==============================================================================
# Eureka Configuration
# ==============================================================================
EUREKA_HOST_DEV=localhost
EUREKA_HOST_TEST=eureka-server
EUREKA_HOST_PROD=eureka-server

EUREKA_PORT_DEV=8761
EUREKA_PORT_TEST=8761
EUREKA_PORT_PROD=8761

EUREKA_PROTOCOL_DEV=http
EUREKA_PROTOCOL_TEST=http
EUREKA_PROTOCOL_PROD=https

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL_DEV=INFO
LOG_LEVEL_TEST=INFO
LOG_LEVEL_PROD=WARN

# ==============================================================================
# Application Configuration
# ==============================================================================
SPRING_PROFILE_DEV=dev
SPRING_PROFILE_TEST=test
SPRING_PROFILE_PROD=prod
